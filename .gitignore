# --- deps, caches, envs ---
node_modules/
.venv/
venv/
.venv-tts/
__pycache__/
*.pyc
.remotion/
models/
.cache/

# --- secrets (never commit) ---
.env
.env.*
*.pem
*.key
credentials*
secrets*

# --- QA & render scratch (stills, contact sheets, and temp profiles) ---
.render-tmp/
videos/*/tmp/
videos/*/qa/stills/
videos/*/qa/cuts/
videos/*/qa/*.jpg
videos/*/qa/*.png
videos/*/qa/*.wav
videos/*/qa/_*.wav
qa/
*.mbtree
x264_2pass.log*
*.remotion-in-progress
tmp_*
tmp_*/
tools/results/
exports/
_build.log

# --- regenerable mixes and per-beat TTS audio scratch (rebuilt by build.py / tts_cb.py) ---
videos/*/master.wav
videos/*/audio/*.wav

# --- render outputs: only the delivered, compressed cuts are kept (Git LFS) ---
videos/*/out/*
!videos/*/out/*.json
!videos/captchas-3min/out/All-in_captchas_3min_v6.mp4
!videos/captchas-full/out/All-in_captchas_full_v3.mp4
!videos/ai-black-markets/out/All-in_*.mp4
!videos/ai-ban/out/All-in_*.mp4
!videos/china-ai-underground/out/All-in_*.mp4
!videos/why-ai-dumber/out/All-in_*.mp4

# --- news clips removed under the MONEY RULE: never commit ---
.removed-news-clips/

# --- raw source media (re-download: scripts/redownload-sources.sh, URLs in LICENCES.md); transcripts stay ---
.cc-src/**/*.mp4
.cc-src/**/*.webm
.cc-src/**/*.opus
.cc-src/**/*.mp3
.cc-src/**/*.m4a
.cc-src/**/*.wav
.cc-src/**/*.ts
.cc-src/**/*.pdf
.cc-src/**/*.html
.cc-src/**/*.done
.cc-src/**/*.url
.cc-src/**/*.log
.cc-src/cnai/

# --- OS / editor ---
Thumbs.db
desktop.ini
.DS_Store
.cloud-env.sh
*.bak
